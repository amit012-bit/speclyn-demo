PORT=8000

# LLM providers — configure at least one. Default priority: Claude -> OpenAI -> Gemini.
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here

# Override the primary provider (claude|openai|gemini). The others stay as
# fallbacks. CLI flags on `python main.py` (--claude/--openai/--gemini) set
# this for you; use the env var directly for uvicorn/Docker/Render.
# LLM_PRIMARY=openai

# Voice transcription (Phase 4 — optional until then).
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# Realtime tuning
ANALYSIS_INTERVAL_SECONDS=15
MAX_GAPS_PER_CYCLE=2

# Comma-separated allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:4000
